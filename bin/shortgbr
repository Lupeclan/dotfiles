#!/usr/bin/env bash
set -e
set -u
set -o pipefail


if [ ! "$(git rev-parse --is-inside-work-tree 2>/dev/null)" = "true" ]; then
  echo "Not inside a git repository."
  exit 1
fi

selected_story=$(echo "" | fzf \
  --bind "change:reload:sleep 0.25;( short search --owner $SHORTCUT_MENTION_NAME --text {q} --format '%id %t' --quiet )" \
  --height 40% \
  --layout=reverse \
  --border \
  --prompt="🩳 Search Shortcut Ticket ➔ " \
  --preview "short story --quiet {}" \
  --preview-window=right:65%:wrap)

if [ -n "$selected_story" ]; then
  id=$(echo "$selected_story" | awk '{print $1}')
  title=$(echo "$selected_story" \
    | awk '{$1=""; print $0}' \
    | sed -E 's/^[[:space:]]+//; s/[[:space:]]+/-/g; s/[^[:alnum:]-]//g' \
    | tr '[:upper:]' '[:lower:]')

  repo_root=$(git rev-parse --show-toplevel)
  repo_dir_name=$(basename "$repo_root")
  shortcut_dir="$HOME/.shortcut/$repo_dir_name"
  mkdir -p "$shortcut_dir"
  rm -f "$shortcut_dir/.shortcut_story_id"
  echo "$id" > "$shortcut_dir/.shortcut_story_id"

  branch_name="sc-$id-$title"
  if git show-ref --verify --quiet "refs/heads/$branch_name"; then
    git checkout "$branch_name"
  else
    git checkout -b "$branch_name"
    git push
  fi
fi
