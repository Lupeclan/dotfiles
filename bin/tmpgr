#!/usr/bin/env bash
set -e
set -u
set -o pipefail

repo="${1:-}"
branch="${2:-main}"

if [[ -z "$repo" ]]; then
  echo "Usage: $0 <repo> [branch]"
  exit 1
fi

cd "$(mktemp -d)"
chmod -R 0700 .
echo "Cloning $repo (branch: $branch) into $(pwd)"
git clone --depth 1 --branch "$branch" "$repo" .
code .
